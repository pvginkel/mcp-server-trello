# Trello API Configuration
# Get your API key from https://trello.com/app-key
TRELLO_API_KEY=your-api-key-here

# Generate your token using your API key
TRELLO_TOKEN=your-token-here

# Optional: Initial workspace ID (can be changed later using set_active_workspace)
# TRELLO_WORKSPACE_ID=your-workspace-id-here

# Optional: Transport. Default is stdio (backward compatible). Set to "http" to
# serve the modern Streamable HTTP transport instead.
# TRELLO_MCP_TRANSPORT=http
# TRELLO_MCP_HTTP_HOST=127.0.0.1
# TRELLO_MCP_HTTP_PORT=3000
# Require "Authorization: Bearer <token>" on every request. Leave unset for the
# localhost default; set it before exposing the server beyond localhost.
# TRELLO_MCP_HTTP_TOKEN=change-me
# Comma-separated Host header allow-list for DNS-rebinding protection. Defaults
# are derived from host:port; set explicitly when binding a public interface.
# TRELLO_MCP_HTTP_ALLOWED_HOSTS=mcp.example.com
