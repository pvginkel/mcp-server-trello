# If your board is `https://trello.com/b/7aABC123A/myorg`
# replace `/myorg` with `.json` like this:
#
# https://trello.com/b/7aABC123A.json`
#
# The first field (`:id`) in the rendered json block is the board id
TRELLO_BOARD_ID=<YOUR-BOARD-ID>

TRELLO_API_KEY=<YOUR-API-KEY> # https://trello.com/app-key
TRELLO_TOKEN=<YOUR-APP-TOKEN> # https://trello.com/1/authorize?expiration=never&name=YOUR_TRELLO_WORKSPACE&scope=read,write&response_type=token&key=YOUR_API_KEY

# Optional: run over Streamable HTTP instead of stdio (default). Uncomment to opt in.
# TRELLO_MCP_TRANSPORT=http
# TRELLO_MCP_HTTP_HOST=127.0.0.1
# TRELLO_MCP_HTTP_PORT=3000
# TRELLO_MCP_HTTP_TOKEN=change-me            # require Authorization: Bearer <token>
# TRELLO_MCP_HTTP_ALLOWED_HOSTS=mcp.example.com  # Host allow-list (DNS-rebinding protection)

# Optional: whether a board/workspace selection is held across calls. Defaults to
# `on` under stdio and `off` under HTTP, where one shared Trello client means a
# board set by one session would silently retarget another's unqualified calls.
# Force it `on` for a single-user HTTP deployment; force it `off` under stdio to
# require an explicit boardId (or TRELLO_BOARD_ID) on every board-scoped call.
# TRELLO_MCP_AMBIENT_SELECTION=on
